<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>MeowMeowFan</AssemblyName>
    <RootNamespace>MeowMeowFan</RootNamespace>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Description>A compact selectable gas ventilation fan for Oxygen Not Included.</Description>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <Nullable>disable</Nullable>

    <!-- Reuse the monorepo metadata generator, but keep this mod unpacked so PLib can ship separately. -->
    <UsePublicised>true</UsePublicised>
    <PublicisedFolder>$(GameLibsFolder)</PublicisedFolder>
    <GenerateMetadata>true</GenerateMetadata>
    <IsPacked>false</IsPacked>
    <ModName>Meow Meow Fan</ModName>
    <ModDescription>Compact selectable gas ventilation fan with configurable power and pumping rate.</ModDescription>
    <SupportedContent>ALL</SupportedContent>
    <MinimumSupportedBuild>744825</MinimumSupportedBuild>
    <APIVersion>2</APIVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PLib" Version="4.25.0" PrivateAssets="all" />
    <PackageReference Include="Lib.Harmony.Ref" Version="2.4.2" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(GameLibsFolder)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(GameLibsFolder)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(GameLibsFolder)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
